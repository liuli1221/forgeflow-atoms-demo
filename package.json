{
  "name": "forgeflow",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeFlow - a hybrid local and DeepSeek-powered app builder with validation and repair.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:llm": "playwright test --config=playwright.live.config.js",
    "test:e2e:production": "playwright test --config=playwright.production.config.js",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
